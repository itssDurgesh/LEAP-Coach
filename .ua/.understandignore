# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.

# --- Dependencies & build output ---
/node_modules
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- Secrets & environment (SECURITY: real env files must never be analyzed) ---
.env
.env*.local
*.pem
# NOTE: .env.local.example is intentionally NOT excluded — it documents required vars.

# --- Tooling / editor / deployment noise ---
.claude
.vercel
.DS_Store
~$*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local docs scratch (empty dir) ---
Docs

# --- Test file patterns (uncomment to exclude tests from analysis) ---
# *.test.*
# *.spec.*
# *.snap

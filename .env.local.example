# ──────────────────────────────────────────────────────────────────────────
# LEAP Coach — environment variables. Copy to .env.local and fill in.
# The app runs entirely on a localStorage mock until the keys below are set,
# then automatically switches to real services.
# ──────────────────────────────────────────────────────────────────────────

# ── Hero video (optional) ────────────────────────────────────────────────────
# The landing-page hero video (35 MB) is too large for git. Upload it to
# Supabase Storage (or any CDN) and paste the public URL here. If unset the
# component falls back to the professor photo.

# ── Authentication: Clerk ───────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com, then copy the keys from
# "API keys". Enable Email, Google, and LinkedIn under "User & Authentication".
# To let Clerk sessions authorize Supabase row-level security, also enable the
# Supabase integration in Clerk and add Clerk as a Third-Party Auth provider in
# Supabase (Authentication → Sign In/Up → Third Party Auth). See supabase/README.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database: Supabase (data store only — auth is handled by Clerk) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI tutor (server-only) ───────────────────────────────────────────────────
# ONE Gemini key for the whole project — the in-app tutor AND the Telegram bot
# both use it. (See docs/TELEGRAM_BOT.md for optional bot-only overrides.)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── Video: Mux ────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── Payments: Razorpay (test keys start rzp_test_) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret. In the Razorpay dashboard add a webhook pointing to
# <your-domain>/api/payments/razorpay/webhook for events payment.captured + order.paid,
# set a secret, and paste the SAME secret here. This guarantees a paid order is always
# recorded + granted even if the user's browser never reaches the verify step.
RAZORPAY_WEBHOOK_SECRET=

# ── Broadcast email (announcements + live-session invites) — see docs/EMAIL.md ──
# Pick ONE provider. If RESEND_API_KEY is set it wins; otherwise Gmail is used.
#
# Option A — Resend + your domain (recommended): verify leapcoach.in in the
# Resend dashboard (DNS records go into Namecheap), then create an API key.
RESEND_API_KEY=
# Sender shown to learners (must be on the verified domain for Resend):
EMAIL_FROM="LEAP Coach <announcements@leapcoach.in>"
#
# Option B — send from your actual Gmail via SMTP. Needs 2-Step Verification ON,
# then create an App Password at https://myaccount.google.com/apppasswords.
# Free Gmail caps at ~500 recipients/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Replies from learners land here (works with either provider):
EMAIL_REPLY_TO=info.leapcoach@gmail.com
# Public site URL used in email links:
NEXT_PUBLIC_SITE_URL=https://www.leapcoach.in
# Optional — signs the per-recipient unsubscribe links. If left blank the app falls
# back to CLERK_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY, so it works without this set.
# Set (and keep) a stable random value to rotate unsubscribe links independently.
EMAIL_UNSUBSCRIBE_SECRET=

# ── API rate limits (all OPTIONAL — sane defaults apply if unset) ────────────
# Per-minute request caps per user (or per IP when signed out). See docs/SECURITY.md.
# RL_AI_PER_MIN=20          # AI tutor (chat + hint) — Gemini denial-of-wallet guard
# RL_PAYMENT_PER_MIN=12     # order / verify / coupon / demo-grant
# RL_ADMIN_PER_MIN=30       # admin user-mgmt, refund, retry-grant
# RL_EMAIL_PER_MIN=6        # broadcast email sends
# RL_TELEGRAM_PER_MIN=10    # telegram link/unlink
# RL_DEFAULT_PER_MIN=60     # everything else (status polling, unsubscribe)
# RL_DISABLED=1             # turn rate limiting off entirely (not recommended)
# AI_MAX_MESSAGE_CHARS=4000 # max characters per AI tutor message

# ──────────────────────────────────────────────────────────────────────────
# LEAP Coach — environment variables. Copy to .env.local and fill in.
# Without the Clerk + Supabase keys the app runs in local demo mode: sign-up and
# data stay in this browser and nothing is sent to Supabase. With both set it
# switches to the real services automatically. Other services switch on as their
# keys are added. Only NEXT_PUBLIC_* values reach the browser.
# ──────────────────────────────────────────────────────────────────────────

# ── Authentication: Clerk ───────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com, then copy the keys from
# "API keys". Enable Email, Google, and LinkedIn under "User & Authentication".
# To let Clerk sessions authorize Supabase row-level security, also enable the
# Supabase integration in Clerk and add Clerk as a Third-Party Auth provider in
# Supabase (Authentication → Sign In/Up → Third Party Auth). See supabase/README.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database and file storage: Supabase (auth is handled by Clerk) ───────────
# The service-role key is server-only: payment fulfilment, owner user management,
# email broadcasts and Telegram linking use it to write past row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI tutor (server-only) ───────────────────────────────────────────────────
# One Gemini key for the in-app tutor and checkpoint hints (the Telegram bot,
# which lives in its own repository, can share it). Without a key the tutor
# answers from a built-in mock.
GEMINI_API_KEY=
# Optional model override. The default is Google's rolling alias
# "gemini-flash-lite-latest"; do not pin a retired id such as gemini-2.5-flash.
# GEMINI_MODEL=gemini-flash-lite-latest

# ── Video: Mux ────────────────────────────────────────────────────────────────
# Not used by the app today: lessons play from the Mux playback id stored on each
# session, which needs no key. Kept for uploading videos through the Mux API later.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── Payments: Razorpay (test keys start rzp_test_) ───────────────────────────
# Without a key id the checkout runs as a demo (no money moves).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret. In the Razorpay dashboard add a webhook pointing to
# <your-domain>/api/payments/razorpay/webhook for payment.captured, refund.created,
# refund.processed and refund.failed (order.paid optional), set a secret, and paste
# the SAME secret here. It records and grants a paid order even if the buyer's
# browser never reaches the verify step, and keeps refunds in sync.
RAZORPAY_WEBHOOK_SECRET=
# Optional — lets a scheduled job call /api/payments/razorpay/reconcile with
# "Authorization: Bearer <secret>" to record any captured payment the app missed.
# Vercel cron sends CRON_SECRET this way, so setting that one is enough there.
# PAYMENTS_RECONCILE_SECRET=
# CRON_SECRET=
# Optional — comma-separated addresses alerted when a paid order cannot be granted.
# Defaults to the owner accounts' emails.
# PAYMENT_ALERT_EMAIL=

# ── Email: announcements, live-session invites, receipts ─────────────────────
# Pick ONE provider. If RESEND_API_KEY is set it is used first, with Gmail as the
# fallback for anything Resend fails to send.
#
# Option A — Resend + your domain (recommended): verify leapcoach.in in the
# Resend dashboard (DNS records go into Namecheap), then create an API key.
RESEND_API_KEY=
# Sender shown to learners (must be on the verified domain for Resend):
EMAIL_FROM="LEAP Coach <announcements@leapcoach.in>"
#
# Option B — send from your actual Gmail via SMTP. Needs 2-Step Verification ON,
# then create an App Password at https://myaccount.google.com/apppasswords.
# Free Gmail caps at ~500 recipients/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Replies from learners land here (works with either provider):
EMAIL_REPLY_TO=info.leapcoach@gmail.com
# Public site URL, used in email links, the sitemap and social previews:
NEXT_PUBLIC_SITE_URL=https://www.leapcoach.in
# Optional — signs the per-recipient unsubscribe links. If left blank the app falls
# back to CLERK_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY, so it works without this set.
# Set (and keep) a stable random value to rotate unsubscribe links independently.
EMAIL_UNSUBSCRIBE_SECRET=

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Username of the coaching bot that learners link from Account. Defaults to
# LeapCoachbot. The bot itself runs from the leap-coach-telegram-bot repository.
# TELEGRAM_BOT_USERNAME=LeapCoachbot

# ── API rate limits (all OPTIONAL — sane defaults apply if unset) ────────────
# Per-minute request caps per user (or per IP when signed out), counted per
# server instance (lib/api/rate-limit.ts).
# RL_AI_PER_MIN=20          # AI tutor (chat + hint) — Gemini denial-of-wallet guard
# RL_PAYMENT_PER_MIN=12     # order / verify / coupon / demo-grant
# RL_ADMIN_PER_MIN=30       # admin user-mgmt, refund, retry-grant
# RL_EMAIL_PER_MIN=6        # broadcast email sends
# RL_TELEGRAM_PER_MIN=10    # telegram link/unlink
# RL_DEFAULT_PER_MIN=60     # everything else (status polling, unsubscribe)
# RL_DISABLED=1             # turn rate limiting off entirely (not recommended)
# AI_MAX_MESSAGE_CHARS=4000 # max characters per AI tutor message

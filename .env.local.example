# ──────────────────────────────────────────────────────────────────────────
# LEAP Coach — environment variables. Copy to .env.local and fill in.
# The app runs entirely on a localStorage mock until the keys below are set,
# then automatically switches to real services.
# ──────────────────────────────────────────────────────────────────────────

# ── Authentication: Clerk ───────────────────────────────────────────────────
# Create an app at https://dashboard.clerk.com, then copy the keys from
# "API keys". Enable Email, Google, and LinkedIn under "User & Authentication".
# To let Clerk sessions authorize Supabase row-level security, also enable the
# Supabase integration in Clerk and add Clerk as a Third-Party Auth provider in
# Supabase (Authentication → Sign In/Up → Third Party Auth). See supabase/README.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database: Supabase (data store only — auth is handled by Clerk) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI tutor (server-only) ───────────────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── Video: Mux ────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── Payments: Razorpay (test keys start rzp_test_) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret. In the Razorpay dashboard add a webhook pointing to
# <your-domain>/api/payments/razorpay/webhook for events payment.captured + order.paid,
# set a secret, and paste the SAME secret here. This guarantees a paid order is always
# recorded + granted even if the user's browser never reaches the verify step.
RAZORPAY_WEBHOOK_SECRET=
